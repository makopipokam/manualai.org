  "description": "pwnd – Pond Strategy: Teich-Aufbauspiel mit Quiz, Angriffen, Ligen und Verteidigungsberichten.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
