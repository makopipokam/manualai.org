{
  "name": "manualai",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:pwnd && npm run test:catsdogs && npm run test:fishroyale && npm run test:manualai",
    "test:manualai": "node manualai/test/api.test.mjs",
    "test:pwnd": "node pwnd/test/pwnd-engine.test.cjs && node pwnd/test/pond-demo.test.cjs && node pwnd/test/pwnd-api.test.mjs && node pwnd/test/online-contract.test.cjs",
    "test:fishroyale": "node fishroyale/test/engine.test.cjs",
    "test:catsdogs": "node catsdogs/deploy.test.mjs",
    "test:mydog:beta": "bash mydog/test/run-beta-regression.sh",
    "test:mydog:android": "bash mydog/test/run-android-preflight.sh",
    "test:mydog:images": "python3 mydog/test/image-regression.py",
    "test:mycat:beta": "bash mycat/test/run-beta-regression.sh",
    "test:mycat:images": "python3 mycat/test/image-regression.py",
    "test:mycat:legal": "python3 mycat/test/legal-pages-regression.py",
    "test:mycat:dating": "python3 mycat/test/dating-profile-regression.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  }
}
