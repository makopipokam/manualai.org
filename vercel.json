{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/pwnd",
      "destination": "/pwnd/index.html"
    },
    {
      "source": "/mydog",
      "destination": "/mydog/index.html"
    },
    {
      "source": "/mycat",
      "destination": "/mycat/index.html"
    },
    {
      "source": "/mycat/cats&dogs",
      "destination": "/mycat/cats&dogs/index.html"
    },
    {
      "source": "/catsdogs",
      "destination": "/catsdogs/index.html"
    },
    {
      "source": "/fishroyale",
      "destination": "/fishroyale/index.html"
    },
    {
      "source": "/TaubenVSKrähen",
      "destination": "/TaubenVSKrähen/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/pwnd",
      "destination": "/pwnd/",
      "permanent": true
    },
    {
      "source": "/mydog",
      "destination": "/mydog/",
      "permanent": true
    },
    {
      "source": "/mycat",
      "destination": "/mycat/",
      "permanent": true
    },
    {
      "source": "/mycat/cats&dogs",
      "destination": "/mycat/cats&dogs/",
      "permanent": true
    },
    {
      "source": "/catsdogs",
      "destination": "/catsdogs/",
      "permanent": true
    },
    {
      "source": "/fishroyale",
      "destination": "/fishroyale/",
      "permanent": true
    },
    {
      "source": "/TaubenVSKrähen",
      "destination": "/TaubenVSKrähen/",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/mydog/images/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/mycat/images/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
